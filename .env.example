NODE_ENV=development
PORT=3000
TZ_NAME=Asia/Jakarta

# Wajib di production: string acak panjang (openssl rand -hex 32)
JWT_SECRET=
JWT_TTL=12h

# Origin frontend, pisahkan dengan koma. Wajib di production.
# Frontend disajikan backend (same-origin), CORS hanya perlu jika frontend di domain lain.
CORS_ORIGINS=http://localhost:3000

DB_PATH=./data/hatiqu.db

# LiveKit (Cloud atau self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
